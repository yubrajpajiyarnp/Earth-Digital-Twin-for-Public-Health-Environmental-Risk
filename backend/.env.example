# Default region for endpoints called without ?region=
# kathmandu_flood | mugling_landslide (alias: nepal_landslide)
PILOT_REGION=kathmandu_flood

# Open-Meteo API keys — all optional. Blank = free non-commercial endpoint;
# set = customer-*.open-meteo.com endpoint (open-meteo.com/en/pricing).
# Kathmandu weather forecast + historical archive, and current conditions
WEATHER_API_KEY=
# GloFAS river discharge for the Bagmati, Bishnumati and Dhobi Khola
FLOOD_API_KEY=
# Mugling-Narayangadh corridor soil moisture, rain, pressure and terrain slope
LANDSLIDE_API_KEY=

# Local ML bundle refresh (days) — retrained in the background on startup when older
MODEL_MAX_AGE_DAYS=7

# Local LLM for narrative text (optional; template text is used without it)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
LLM_NARRATIVE_ENABLED=true

# developer.accuweather.com free key — failsafe if Open-Meteo current conditions fail
ACCUWEATHER_API_KEY=
