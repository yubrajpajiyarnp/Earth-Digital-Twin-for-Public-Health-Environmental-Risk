PILOT_CITY=Vellore
PILOT_LAT=12.9165
PILOT_LON=79.1325

# Google Earth Engine Cloud Project ID (code.earthengine.google.com registration)
# Auth is separate: run `earthengine authenticate` once per machine, see CLAUDE.md
GEE_PROJECT_ID=course-506318

# data.gov.in account -> API key (CPCB real-time AQI resource)
DATA_GOV_IN_API_KEY=

# openaq.org free registration
OPENAQ_API_KEY=

# api.imd.gov.in - requires formal request / IP whitelisting, see CLAUDE.md
IMD_API_KEY=

# dataspace.copernicus.eu free registration (OAuth2 client credentials)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# purepriceio.com dashboard -> API key AND a separate Client ID (both required)
FUEL_PRICE_API_KEY=
FUEL_PRICE_CLIENT_ID=

# developers.carbonmark.com -> Keys page -> generate a free Sandbox test key (Bearer token)
CARBON_PRICE_API_KEY=
